# ------------------------------------------------------------------
# Copy this file to `backend/.env` (same folder) and paste your key.
# Get a FREE Gemini key at https://aistudio.google.com/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (must be available on the free tier)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: server port (the frontend proxies to 3001 by default)
# PORT=3001

# ------------------------------------------------------------------
# Alternative provider: Groq (https://console.groq.com/keys)
# Used automatically if GEMINI_API_KEY is not set.
# ------------------------------------------------------------------
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
